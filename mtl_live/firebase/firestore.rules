rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Événements : lecture publique, écriture admin/cloud functions seulement
    match /events/{eventId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Profils utilisateurs
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;

      // Favoris
      match /favorites/{favoriteId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Plans de soirée
      match /plans/{planId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Photos user-generated
    match /event_photos/{photoId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.size() <= 10;
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }

    // Métadonnées de sync / refresh
    match /metadata/{docId} {
      allow read: if true;
      allow write: if false; // Cloud Functions seulement
    }

    // Données météo en cache
    match /weather/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
